# Common Windows applications and supported per-user preferences.
# This capability intentionally avoids edition-limited policy keys.

$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
  - type: Microsoft.WinGet/Package
    name: WindowsTerminal
    properties:
      id: Microsoft.WindowsTerminal
      source: winget
      useLatest: true
      installMode: silent
      acceptAgreements: true
    metadata:
      description: Install Windows Terminal

  - type: Microsoft.WinGet/Package
    name: Chrome
    properties:
      id: Google.Chrome.EXE
      source: winget
      useLatest: true
      installMode: silent
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated
      description: Install Google Chrome

  - type: Microsoft.WinGet/Package
    name: Firefox
    properties:
      id: Mozilla.Firefox
      source: winget
      useLatest: true
      installMode: silent
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated
      description: Install Mozilla Firefox

  - type: Microsoft.WinGet/Package
    name: Discord
    properties:
      id: Discord.Discord
      source: winget
      useLatest: true
      installMode: silent
      acceptAgreements: true
    metadata:
      description: Install Discord

  - type: Microsoft.WinGet/Package
    name: Spotify
    properties:
      id: Spotify.Spotify
      source: winget
      useLatest: true
      installMode: silent
      acceptAgreements: true
    metadata:
      description: Install Spotify

  - type: Microsoft.Windows/Registry
    name: TaskbarAlignLeft
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: TaskbarAl
      valueData:
        DWord: 0
      _exist: true
    metadata:
      description: Align the Windows 11 taskbar to the left

  - type: Microsoft.Windows/Registry
    name: TaskbarSearchIconOnly
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Search
      valueName: SearchboxTaskbarMode
      valueData:
        DWord: 1
      _exist: true
    metadata:
      description: Show only the search icon on the taskbar

  - type: Microsoft.Windows/Registry
    name: TaskbarHideTaskView
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: ShowTaskViewButton
      valueData:
        DWord: 0
      _exist: true
    metadata:
      description: Hide the Task View button

  - type: Microsoft.Windows/Registry
    name: TaskbarHideWidgets
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: TaskbarDa
      valueData:
        DWord: 0
      _exist: true
    metadata:
      description: Hide the Widgets button

  - type: Microsoft.Windows/Registry
    name: TaskbarBatteryPercentage
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: IsBatteryPercentageEnabled
      valueData:
        DWord: 1
      _exist: true
    metadata:
      description: Show battery percentage when the hardware exposes a battery

  - type: Microsoft.Windows/Registry
    name: ClassicContextMenu
    properties:
      keyPath: HKCU\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32
      valueName: ""
      valueData:
        String: ""
      _exist: true
    metadata:
      description: Restore the classic context menu with labeled commands

  - type: Microsoft.Windows/Registry
    name: ExplorerShowFileExtensions
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: HideFileExt
      valueData:
        DWord: 0
      _exist: true
    metadata:
      description: Show file extensions in File Explorer

  - type: Microsoft.Windows/Registry
    name: ExplorerDisableSyncProviderAds
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: ShowSyncProviderNotifications
      valueData:
        DWord: 0
      _exist: true
    metadata:
      description: Disable promotional sync-provider notifications in File Explorer

  - type: Microsoft.Windows/Registry
    name: SearchDisableHighlights
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\SearchSettings
      valueName: IsDynamicSearchBoxEnabled
      valueData:
        DWord: 0
      _exist: true
    metadata:
      description: Disable search highlights

  - type: Microsoft.Windows/Registry
    name: StartDisableRecommendations
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced
      valueName: Start_IrisRecommendations
      valueData:
        DWord: 0
      _exist: true
    metadata:
      description: Disable recommendations in Start

  - type: Microsoft.Windows/Registry
    name: DisableSuggestedContent
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
      valueName: SubscribedContent-338388Enabled
      valueData:
        DWord: 0
      _exist: true
    metadata:
      description: Disable suggested apps and promoted content

  - type: Microsoft.Windows/Registry
    name: DisableSilentAppInstalls
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
      valueName: SilentInstalledAppsEnabled
      valueData:
        DWord: 0
      _exist: true
    metadata:
      description: Disable silent installation of promoted apps

  - type: Microsoft.Windows/Registry
    name: DisableAdvertisingId
    properties:
      keyPath: HKCU\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo
      valueName: Enabled
      valueData:
        DWord: 0
      _exist: true
    metadata:
      description: Disable the per-user advertising identifier

  - type: Microsoft.Windows/Registry
    name: DisableRecallForUser
    properties:
      keyPath: HKCU\Software\Policies\Microsoft\Windows\WindowsAI
      valueName: DisableAIDataAnalysis
      valueData:
        DWord: 1
      _exist: true
    metadata:
      description: Disable saving Recall snapshots for the current user

  - type: Microsoft.Windows/Registry
    name: DisableRecallForMachine
    properties:
      keyPath: HKLM\Software\Policies\Microsoft\Windows\WindowsAI
      valueName: DisableAIDataAnalysis
      valueData:
        DWord: 1
      _exist: true
    metadata:
      winget:
        securityContext: elevated
      description: Disable saving Recall snapshots for the machine

  - type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    name: WindowsTerminalFont
    dependsOn:
      - WindowsTerminal
    properties:
      getScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-font.ps1"
        $output = @(& powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $script -Check -ConfigureWindowsTerminal 2>&1)
        return @{ exitCode = $LASTEXITCODE; summary = ($output -join "`n") }
      testScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-font.ps1"
        $null = & powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $script -Check -ConfigureWindowsTerminal
        return ($LASTEXITCODE -eq 0)
      setScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-font.ps1"
        & powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $script -ConfigureWindowsTerminal
        if ($LASTEXITCODE -ne 0) { throw "Windows font helper failed with exit code $LASTEXITCODE." }
    metadata:
      description: Install the checksum-pinned MesloLGL Nerd Font and select it in Windows Terminal
