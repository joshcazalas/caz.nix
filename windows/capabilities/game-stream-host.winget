# Security-critical applications and state for the generic game-stream host.

$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
  - type: Microsoft.WinGet/Package
    name: Sunshine
    properties:
      id: LizardByte.Sunshine
      source: winget
      installMode: silent
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated
      description: Ensure the stable Sunshine host package is installed

  - type: Microsoft.WinGet/Package
    name: WireGuard
    properties:
      id: WireGuard.WireGuard
      source: winget
      installMode: silent
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated
      description: Ensure the official WireGuard Windows package is installed

  - type: Microsoft.Windows/Registry
    name: DisableLockScreenAppNotifications
    properties:
      keyPath: HKLM\Software\Policies\Microsoft\Windows\System
      valueName: DisableLockScreenAppNotifications
      valueData:
        DWord: 1
      _exist: true
    metadata:
      winget:
        securityContext: elevated
      description: Prevent a remotely visible lock screen from exposing app notifications

  - type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    name: GameStreamHostPolicy
    dependsOn:
      - Sunshine
      - WireGuard
      - DisableLockScreenAppNotifications
    properties:
      getScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-game-stream.ps1"
        $context = Get-Content -LiteralPath "${WinGetConfigRoot}\game-stream-context.json" -Raw | ConvertFrom-Json
        $arguments = @('-NoLogo', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', $script, '-Role', 'Host', '-Stage', $context.stage, '-SourceDigest', $context.sourceDigest, '-Check')
        $PSNativeCommandUseErrorActionPreference = $false
        $output = @(& powershell.exe @arguments 2>&1)
        return @{ exitCode = $LASTEXITCODE; summary = ($output -join "`n") }
      testScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-game-stream.ps1"
        $context = Get-Content -LiteralPath "${WinGetConfigRoot}\game-stream-context.json" -Raw | ConvertFrom-Json
        $arguments = @('-NoLogo', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', $script, '-Role', 'Host', '-Stage', $context.stage, '-SourceDigest', $context.sourceDigest, '-Check')
        $PSNativeCommandUseErrorActionPreference = $false
        $output = @(& powershell.exe @arguments 2>&1)
        $exitCode = $LASTEXITCODE
        if ($exitCode -in @(20, 30)) { Write-Warning ($output -join "`n") }
        if ($context.stage -eq 'Lan') { return ($exitCode -in @(0, 20, 30)) }
        return ($exitCode -in @(0, 30))
      setScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-game-stream.ps1"
        $context = Get-Content -LiteralPath "${WinGetConfigRoot}\game-stream-context.json" -Raw | ConvertFrom-Json
        $arguments = @('-NoLogo', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', $script, '-Role', 'Host', '-Stage', $context.stage, '-SourceCommit', $context.sourceCommit, '-SourceDigest', $context.sourceDigest)
        if (-not [string]::IsNullOrWhiteSpace($context.enrollmentFile)) { $arguments += @('-EnrollmentFile', $context.enrollmentFile) }
        $PSNativeCommandUseErrorActionPreference = $false
        $ErrorActionPreference = 'Continue'
        $output = @(& powershell.exe @arguments 2>&1)
        $exitCode = $LASTEXITCODE
        $ErrorActionPreference = 'Stop'
        if ($exitCode -ne 0) { throw "Game-stream host helper failed with exit code $exitCode.`n$($output -join "`n")" }
        $output | Write-Host
    metadata:
      winget:
        securityContext: elevated
      description: Apply the selected LAN or remote host stage and trusted shared-console baseline
