# Destructive, machine-wide desired-absent state. No default profile selects
# this capability; it must be opted into deliberately.

$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
  - type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    name: RemoveCuratedBloat
    properties:
      getScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-debloat.ps1"
        $output = @(& powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $script -Check 2>&1)
        return @{ exitCode = $LASTEXITCODE; summary = ($output -join "`n") }
      testScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-debloat.ps1"
        $null = & powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $script -Check
        return ($LASTEXITCODE -eq 0)
      setScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-debloat.ps1"
        & powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $script
        if ($LASTEXITCODE -ne 0) { throw "Windows debloat helper failed with exit code $LASTEXITCODE." }
    metadata:
      winget:
        securityContext: elevated
      description: Remove an explicit list of Appx packages for all users and the provisioned image
