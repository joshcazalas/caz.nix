# Security-critical applications and state for the generic game-stream client.

$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
  - type: Microsoft.WinGet/Package
    name: Moonlight
    properties:
      id: MoonlightGameStreamingProject.Moonlight
      source: winget
      installMode: silent
      acceptAgreements: true
    metadata:
      description: Ensure the Moonlight client is installed

  - type: Microsoft.WinGet/Package
    name: WireGuard
    properties:
      id: WireGuard.WireGuard
      source: winget
      installMode: silent
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated
      description: Ensure the official WireGuard Windows package is installed

  - type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    name: GameStreamClientPolicy
    dependsOn:
      - Moonlight
      - WireGuard
    properties:
      getScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-game-stream.ps1"
        $context = Get-Content -LiteralPath "${WinGetConfigRoot}\game-stream-context.json" -Raw | ConvertFrom-Json
        $arguments = @('-NoLogo', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', $script, '-Role', 'Client', '-Stage', $context.stage, '-SourceDigest', $context.sourceDigest, '-Check')
        $PSNativeCommandUseErrorActionPreference = $false
        $output = @(& powershell.exe @arguments 2>&1)
        return @{ exitCode = $LASTEXITCODE; summary = ($output -join "`n") }
      testScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-game-stream.ps1"
        $context = Get-Content -LiteralPath "${WinGetConfigRoot}\game-stream-context.json" -Raw | ConvertFrom-Json
        $arguments = @('-NoLogo', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', $script, '-Role', 'Client', '-Stage', $context.stage, '-SourceDigest', $context.sourceDigest, '-Check')
        $PSNativeCommandUseErrorActionPreference = $false
        $output = @(& powershell.exe @arguments 2>&1)
        $exitCode = $LASTEXITCODE
        if ($exitCode -eq 30) { Write-Warning ($output -join "`n") }
        return ($exitCode -in @(0, 30))
      setScript: |
        $script = "${WinGetConfigRoot}\scripts\windows-game-stream.ps1"
        $context = Get-Content -LiteralPath "${WinGetConfigRoot}\game-stream-context.json" -Raw | ConvertFrom-Json
        $arguments = @('-NoLogo', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', $script, '-Role', 'Client', '-Stage', $context.stage, '-SourceCommit', $context.sourceCommit, '-SourceDigest', $context.sourceDigest)
        if (-not [string]::IsNullOrWhiteSpace($context.enrollmentFile)) { $arguments += @('-EnrollmentFile', $context.enrollmentFile) }
        $PSNativeCommandUseErrorActionPreference = $false
        $ErrorActionPreference = 'Continue'
        $output = @(& powershell.exe @arguments 2>&1)
        $exitCode = $LASTEXITCODE
        $ErrorActionPreference = 'Stop'
        if ($exitCode -ne 0) { throw "Game-stream client helper failed with exit code $exitCode.`n$($output -join "`n")" }
        $output | Write-Host
    metadata:
      winget:
        securityContext: elevated
      description: Apply the selected LAN or independently keyed remote client stage
